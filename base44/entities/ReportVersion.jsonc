{
  "name": "ReportVersion",
  "type": "object",
  "description": "Generated report version with period locking. Tracks which entries are included, preserves superseded versions, and prevents editing locked periods.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string",
      "description": "Client this report is for"
    },
    "entry_type_code": {
      "type": "string",
      "description": "Entry type included in report (e.g. 'job_coaching', 'job_development')"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to PDFTemplate used for generation"
    },
    "template_version": {
      "type": "string",
      "description": "Version of template used (e.g. '2024-Q1', 'v3'). Enables rollback/comparison."
    },
    "report_start_date": {
      "type": "string",
      "format": "date",
      "description": "First day of reporting period"
    },
    "report_end_date": {
      "type": "string",
      "format": "date",
      "description": "Last day of reporting period"
    },
    "included_time_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of TimeEntry records included in this report generation"
    },
    "included_answer_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ReportFieldAnswer records included in this report (for audit trail)"
    },
    "time_entry_count": {
      "type": "number",
      "description": "Number of time entries included"
    },
    "total_hours": {
      "type": "number",
      "description": "Sum of hours from included entries"
    },
    "generated_file_url": {
      "type": "string",
      "description": "URL to generated PDF file"
    },
    "generated_file_name": {
      "type": "string",
      "description": "Original PDF file name"
    },
    "version_number": {
      "type": "number",
      "description": "Auto-incrementing version (1, 2, 3...)"
    },
    "supersedes_report_id": {
      "type": "string",
      "description": "If regenerating, ID of previous version this supersedes. null if initial version."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when report was generated"
    },
    "generated_by": {
      "type": "string",
      "description": "Email of user who generated this report"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether the reporting period is locked (prevents TimeEntry changes)"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when period was locked"
    },
    "locked_by": {
      "type": "string",
      "description": "Email of user who locked the period"
    },
    "lock_reason": {
      "type": "string",
      "description": "Why the period was locked (e.g., 'Submitted to VR', 'Finalized')"
    },
    "is_final": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is final/submitted version (no further regeneration)"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When report was submitted/finalized"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of user who submitted"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this version or regeneration reason"
    }
  },
  "required": [
    "client_id",
    "entry_type_code",
    "template_id",
    "report_start_date",
    "report_end_date",
    "included_time_entry_ids",
    "included_answer_record_ids",
    "generated_file_url",
    "generated_at"
  ]
}