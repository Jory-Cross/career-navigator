{
  "name": "EntryType",
  "type": "object",
  "description": "Defines a service/time-entry type and its reporting behavior.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "vr",
        "pre_ets",
        "dspd",
        "internal",
        "other"
      ],
      "default": "vr"
    },
    "report_mode": {
      "type": "string",
      "enum": [
        "none",
        "usor95_monthly",
        "usor96_monthly",
        "usor148_service_period",
        "custom"
      ],
      "default": "none"
    },
    "default_pdf_template_id": {
      "type": "string"
    },
    "requires_client": {
      "type": "boolean",
      "default": true
    },
    "requires_authorization": {
      "type": "boolean",
      "default": false
    },
    "requires_employer": {
      "type": "boolean",
      "default": false
    },
    "is_billable": {
      "type": "boolean",
      "default": false
    },
    "is_payroll_eligible": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ]
}