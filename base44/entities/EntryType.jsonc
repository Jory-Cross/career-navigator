{
  "name": "EntryType",
  "type": "object",
  "description": "Defines a service/time-entry type and controls its reporting mode, billing, payroll eligibility, and authorization requirements.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Unique machine-readable code used as the stable FK across the system (e.g. 'job_coaching', 'job_development')"
    },
    "description": {
      "type": "string"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "vr",
        "pre_ets",
        "dspd",
        "internal",
        "other"
      ],
      "default": "vr"
    },
    "report_mode": {
      "type": "string",
      "enum": [
        "none",
        "usor95_monthly",
        "usor96_monthly",
        "usor148_service_period",
        "custom"
      ],
      "default": "none",
      "description": "Controls which PDF template type and aggregation logic is used for reporting"
    },
    "default_pdf_template_id": {
      "type": "string",
      "description": "Default PDFTemplate to use when generating reports for this entry type"
    },
    "requires_client": {
      "type": "boolean",
      "default": true
    },
    "requires_authorization": {
      "type": "boolean",
      "default": false,
      "description": "If true, a valid ServiceAuthorization must exist before time can be logged"
    },
    "requires_employer": {
      "type": "boolean",
      "default": false,
      "description": "If true, employer_name is required on the ServiceAuthorization"
    },
    "is_billable": {
      "type": "boolean",
      "default": false,
      "description": "Whether time entries of this type are billable to VR"
    },
    "is_payroll_eligible": {
      "type": "boolean",
      "default": true,
      "description": "Whether time entries count toward employee payroll"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string",
      "description": "Hex color for calendar/UI display"
    },
    "max_hours_per_period": {
      "type": "number",
      "description": "NEW: Optional cap on hours per reporting period. Null = no cap."
    },
    "requires_field_answers": {
      "type": "boolean",
      "default": false,
      "description": "NEW: If true, staff must complete ReportFieldAnswer before entry can be marked report_ready"
    }
  },
  "required": [
    "name",
    "code"
  ]
}