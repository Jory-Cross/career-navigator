{
  "name": "PDFTemplate",
  "type": "object",
  "description": "Stores a PDF form file and its metadata. Can be updated independently of EntryType or field definitions.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "entry_type_id": {
      "type": "string",
      "description": "The EntryType this PDF template is used for"
    },
    "entry_type_code": {
      "type": "string",
      "description": "Denormalized entry type code"
    },
    "name": {
      "type": "string",
      "description": "Template name (e.g. 'Job Coaching Monthly Report v2')"
    },
    "pdf_file_url": {
      "type": "string",
      "description": "URL of the uploaded fillable PDF base file"
    },
    "version": {
      "type": "string",
      "description": "Version label (e.g. '2024-Q1', 'v3')"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current active template for its entry type"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this template version"
    }
  },
  "required": [
    "entry_type_id",
    "name",
    "pdf_file_url"
  ]
}