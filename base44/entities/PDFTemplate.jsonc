{
  "name": "PDFTemplate",
  "type": "object",
  "description": "Uploaded fillable PDF template used for report generation.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "template_code": {
      "type": "string"
    },
    "report_mode": {
      "type": "string",
      "enum": [
        "usor95_monthly",
        "usor96_monthly",
        "usor148_service_period",
        "custom"
      ]
    },
    "pdf_file_url": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "field_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "entry_type_code",
    "pdf_file_url",
    "template_version"
  ]
}