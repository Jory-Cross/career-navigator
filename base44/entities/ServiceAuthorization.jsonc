{
  "name": "ServiceAuthorization",
  "type": "object",
  "description": "Authorization record for a client's service. Provides report header values: authorization number, counselor, job goal, and authorized hours.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string",
      "description": "Links to EntryType.code to scope which time entries consume this authorization"
    },
    "authorization_number": {
      "type": "string",
      "description": "Official USOR authorization number \u2014 appears on PDF header"
    },
    "vr_counselor_name": {
      "type": "string"
    },
    "vr_counselor_email": {
      "type": "string"
    },
    "vr_counselor_phone": {
      "type": "string"
    },
    "job_goal": {
      "type": "string",
      "description": "Client's stated job goal \u2014 appears on PDF header"
    },
    "employer_name": {
      "type": "string",
      "description": "Current or target employer \u2014 used for job coaching reports"
    },
    "service_start_date": {
      "type": "string",
      "format": "date"
    },
    "service_end_date": {
      "type": "string",
      "format": "date"
    },
    "total_authorized_hours": {
      "type": "number",
      "default": 0
    },
    "used_hours": {
      "type": "number",
      "default": 0,
      "description": "Computed from approved TimeEntry records"
    },
    "remaining_hours": {
      "type": "number",
      "default": 0,
      "description": "Computed: total_authorized_hours - used_hours"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "expired",
        "closed",
        "cancelled"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "entry_type_code",
    "authorization_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "management",
            "employee"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.org_id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.org_id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}