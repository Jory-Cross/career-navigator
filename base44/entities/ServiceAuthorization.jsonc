{
  "name": "ServiceAuthorization",
  "type": "object",
  "description": "Tracks authorized services/hours and report header values for a client.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "authorization_number": {
      "type": "string"
    },
    "vr_counselor_name": {
      "type": "string"
    },
    "vr_counselor_email": {
      "type": "string"
    },
    "vr_counselor_phone": {
      "type": "string"
    },
    "job_goal": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "service_start_date": {
      "type": "string",
      "format": "date"
    },
    "service_end_date": {
      "type": "string",
      "format": "date"
    },
    "total_authorized_hours": {
      "type": "number",
      "default": 0
    },
    "used_hours": {
      "type": "number",
      "default": 0
    },
    "remaining_hours": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "expired",
        "closed",
        "cancelled"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "entry_type_code",
    "authorization_number"
  ]
}