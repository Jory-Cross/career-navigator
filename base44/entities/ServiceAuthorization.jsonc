{
  "name": "ServiceAuthorization",
  "type": "object",
  "description": "Authorization record for a client's service. Provides report header values: authorization number, counselor, job goal, and authorized hours.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string",
      "description": "Links to EntryType.code to scope which time entries consume this authorization"
    },
    "authorization_number": {
      "type": "string",
      "description": "Official USOR authorization number — appears on PDF header"
    },
    "vr_counselor_name": {
      "type": "string"
    },
    "vr_counselor_email": {
      "type": "string"
    },
    "vr_counselor_phone": {
      "type": "string"
    },
    "job_goal": {
      "type": "string",
      "description": "Client's stated job goal — appears on PDF header"
    },
    "employer_name": {
      "type": "string",
      "description": "Current or target employer — used for job coaching reports"
    },
    "service_start_date": {
      "type": "string",
      "format": "date"
    },
    "service_end_date": {
      "type": "string",
      "format": "date"
    },
    "total_authorized_hours": {
      "type": "number",
      "default": 0
    },
    "used_hours": {
      "type": "number",
      "default": 0,
      "description": "Computed only from TimeEntry records that satisfy the server-enforced forward-only authorization-usage rule."
    },
    "remaining_hours": {
      "type": "number",
      "default": 0,
      "description": "Computed as total_authorized_hours minus server-approved counted usage."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "expired",
        "closed",
        "cancelled"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "entry_type_code",
    "authorization_number"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
