{
  "name": "ServiceAuthorization",
  "type": "object",
  "description": "VR service authorization for a client. Tracks authorized hours, usage, and service details.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client this authorization applies to"
    },
    "service_type_code": {
      "type": "string",
      "enum": [
        "job_development",
        "job_coaching",
        "life_skills",
        "cbh",
        "pre_ets",
        "admin",
        "other"
      ],
      "description": "Type of VR service being authorized"
    },
    "authorization_number": {
      "type": "string",
      "description": "Unique authorization ID from VR agency (e.g. 'AUTH-2024-001234')"
    },
    "vr_counselor_name": {
      "type": "string",
      "description": "Name of VR counselor who authorized this"
    },
    "job_goal": {
      "type": "string",
      "description": "Employment goal for this service (e.g. 'Retail Manager')"
    },
    "employer_name": {
      "type": "string",
      "description": "Employer or employer type if applicable"
    },
    "total_authorized_hours": {
      "type": "number",
      "description": "Total hours authorized for this service"
    },
    "used_hours": {
      "type": "number",
      "default": 0,
      "description": "Hours logged against this authorization (auto-calculated)"
    },
    "remaining_hours": {
      "type": "number",
      "description": "Calculated field: total_authorized_hours - used_hours"
    },
    "authorization_start_date": {
      "type": "string",
      "format": "date",
      "description": "Date authorization becomes effective"
    },
    "authorization_end_date": {
      "type": "string",
      "format": "date",
      "description": "Date authorization expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "expired",
        "cancelled",
        "exhausted"
      ],
      "default": "active",
      "description": "Authorization status"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this authorization"
    }
  },
  "required": [
    "client_id",
    "service_type_code",
    "authorization_number",
    "total_authorized_hours",
    "authorization_start_date",
    "authorization_end_date"
  ]
}