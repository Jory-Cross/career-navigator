{
  "name": "FeaturePermission",
  "type": "object",
  "description": "Controls which features/pages are visible and interactive per staff role, client portal role, or CE Training role.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant org ID"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "management",
        "employee",
        "client",
        "pre_ets",
        "dspd",
        "ce_instructor",
        "ce_student"
      ],
      "description": "Staff role (admin/management/employee), client portal role (client/pre_ets/dspd), or CE Training role (ce_instructor/ce_student)"
    },
    "feature_key": {
      "type": "string",
      "description": "Unique key for the feature (e.g. time_tracking, clients, ce_training_portal)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label for the feature"
    },
    "category": {
      "type": "string",
      "description": "Grouping category (e.g. core, clinical, admin, client_portal, ce_training)"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether this feature is visible to users with this role"
    },
    "can_interact": {
      "type": "boolean",
      "default": true,
      "description": "Whether users with this role can interact (edit/create) \u2014 not yet used in V1"
    }
  },
  "required": [
    "role",
    "feature_key"
  ]
}