{
  "name": "FeaturePermission",
  "type": "object",
  "description": "Organization-scoped feature visibility and interaction settings. Read and changed only through the authorized feature-permission route.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Canonical Organization.id scope. Required for every feature-permission record."
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "management",
        "employee",
        "client",
        "pre_ets",
        "dspd",
        "ce_instructor",
        "ce_student"
      ],
      "description": "Staff, client portal, or CE Training role governed by this setting."
    },
    "feature_key": {
      "type": "string",
      "description": "Server-validated feature key."
    },
    "label": {
      "type": "string",
      "description": "Server-derived human-readable feature label."
    },
    "category": {
      "type": "string",
      "description": "Server-derived feature category."
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether users with this role may view the feature."
    },
    "can_interact": {
      "type": "boolean",
      "default": true,
      "description": "Whether users with this role may interact with the feature."
    }
  },
  "required": [
    "org_id",
    "role",
    "feature_key"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
