{
  "name": "PlatformAdmin",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID for the internal platform owner or authorized platform support staff."
    },
    "platform_role": {
      "type": "string",
      "enum": [
        "platform_owner",
        "platform_support",
        "platform_billing",
        "platform_auditor"
      ],
      "description": "Platform-level role. This is separate from all customer organization roles."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Controls whether this person currently has platform-level access."
    },
    "support_access_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allows this person to open future audited support sessions into customer organizations."
    }
  },
  "required": [
    "user_id",
    "platform_role"
  ]
}
