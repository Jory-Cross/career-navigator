{
  "name": "VocationalThemeCandidateGraph",
  "type": "object",
  "description": "Persisted discovery evidence graph for a vocational theme candidate. Server-authorized workflows enforce tenant and client scope before rebuilding or reading the graph.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string",
      "description": "FK to Client"
    },
    "candidate_theme_name": {
      "type": "string",
      "description": "Exact name of the vocational theme candidate"
    },
    "category_label": {
      "type": "string",
      "description": "Category this candidate was synthesized from"
    },
    "supporting_themes": {
      "type": "array",
      "description": "List of distinct theme names that support this candidate",
      "items": {
        "type": "object",
        "properties": {
          "theme_name": { "type": "string" },
          "evidence_count": { "type": "number" },
          "concept_count": { "type": "number" }
        }
      }
    },
    "supporting_concepts": {
      "type": "array",
      "description": "List of distinct concepts supporting the candidate",
      "items": {
        "type": "object",
        "properties": {
          "concept_name": { "type": "string" },
          "concept_type": { "type": "string", "enum": ["interest", "skill", "value", "condition_for_success", "barrier"] },
          "evidence_count": { "type": "number" }
        }
      }
    },
    "supporting_source_types": { "type": "array", "items": { "type": "string" } },
    "supporting_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "supporting_evidence_count": { "type": "number" },
    "supporting_concept_count": { "type": "number" },
    "supporting_theme_count": { "type": "number" },
    "supporting_source_count": { "type": "number" },
    "feedback_count": { "type": "number" },
    "consensus_status": {
      "type": "string",
      "enum": ["Strongly Supported", "Emerging Support", "Weak Support", "Needs More Discovery", "Mixed Feedback", "No Feedback"]
    },
    "last_rebuilt_date": { "type": "string", "format": "date-time" },
    "is_active": { "type": "boolean", "default": true }
  },
  "required": [
    "org_id",
    "client_id",
    "candidate_theme_name",
    "category_label",
    "supporting_evidence_count",
    "supporting_concept_count",
    "supporting_theme_count",
    "supporting_source_count"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}