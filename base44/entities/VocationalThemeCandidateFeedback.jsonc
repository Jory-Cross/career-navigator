{
  "name": "VocationalThemeCandidateFeedback",
  "type": "object",
  "description": "Feedback on vocational theme candidates from staff/students and cohort managers. Supports CE certification testing and discovery planning.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string",
      "description": "FK to Client"
    },
    "candidate_theme_name": {
      "type": "string",
      "description": "Exact name of the vocational theme candidate (e.g. 'Retail Customer Service')"
    },
    "category_label": {
      "type": "string",
      "description": "Category this candidate was synthesized from (e.g. 'Emerging Interests', 'Vocational Themes Evidence'). Enables drilling back to source evidence."
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "User ID of the staff/student providing feedback"
    },
    "reviewer_role": {
      "type": "string",
      "description": "Platform role of reviewer (admin, management, employee) at time of feedback"
    },
    "cohort_id": {
      "type": "string",
      "description": "Optional FK to CETrainingCohort if feedback is cohort-scoped. Null = non-cohort feedback."
    },
    "staff_validation": {
      "type": "string",
      "enum": [
        "supported",
        "needs_more_discovery",
        "not_relevant"
      ],
      "description": "Staff assessment of the candidate's relevance and readiness"
    },
    "evidence_quality": {
      "type": "string",
      "enum": [
        "sufficient_evidence",
        "more_evidence_needed",
        "weak_evidence_base"
      ],
      "description": "Staff assessment of supporting evidence strength"
    },
    "use_for_future_discovery": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "description": "Should this candidate be carried forward for further discovery?"
    },
    "notes": {
      "type": "string",
      "description": "Free-text feedback, reasoning, observations"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Soft-delete: false = archived/withdrawn feedback"
    },
    "feedback_date": {
      "type": "string",
      "format": "date",
      "description": "Date of feedback submission"
    }
  },
  "required": [
    "org_id",
    "client_id",
    "candidate_theme_name",
    "category_label",
    "reviewer_user_id"
  ],
  "rls": {}
}