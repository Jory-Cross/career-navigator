{
  "name": "VocationalThemeCandidateFeedback",
  "type": "object",
  "description": "Feedback on vocational theme candidates from staff and cohort managers. Server-authorized workflows enforce tenant, client, cohort, and reviewer scope.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "feedback_key": {
      "type": "string",
      "description": "Deterministic composite key: ${client_id}::${normalized_candidate_theme_name}::${reviewer_user_id}."
    },
    "client_id": {
      "type": "string",
      "description": "FK to Client"
    },
    "candidate_theme_name": {
      "type": "string",
      "description": "Exact name of the vocational theme candidate."
    },
    "category_label": {
      "type": "string",
      "description": "Category this candidate was synthesized from."
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "User ID of the staff member providing feedback."
    },
    "reviewer_role": {
      "type": "string",
      "description": "Canonical platform role of reviewer at time of feedback."
    },
    "cohort_id": {
      "type": "string",
      "description": "Optional FK to CETrainingCohort if feedback is cohort-scoped."
    },
    "staff_validation": {
      "type": "string",
      "enum": [
        "supported",
        "needs_more_discovery",
        "not_relevant"
      ],
      "description": "Staff assessment of the candidate's relevance and readiness"
    },
    "evidence_quality": {
      "type": "string",
      "enum": [
        "sufficient_evidence",
        "more_evidence_needed",
        "weak_evidence_base"
      ],
      "description": "Staff assessment of supporting evidence strength"
    },
    "use_for_future_discovery": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "description": "Whether this candidate should be carried forward for further discovery."
    },
    "notes": {
      "type": "string",
      "description": "Free-text feedback, reasoning, and observations."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Soft-delete: false = archived or withdrawn feedback."
    },
    "feedback_date": {
      "type": "string",
      "format": "date",
      "description": "Date of feedback submission"
    }
  },
  "required": [
    "org_id",
    "client_id",
    "candidate_theme_name",
    "category_label",
    "reviewer_user_id",
    "feedback_key"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}