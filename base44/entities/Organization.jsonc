{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business/organization name"
    },
    "industry": {
      "type": "string",
      "description": "Business industry"
    },
    "website": {
      "type": "string",
      "description": "Business website URL"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo image URL"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the admin who created the org"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "professional",
        "enterprise"
      ],
      "default": "trial",
      "description": "Subscription plan"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "cancelled",
        "incomplete"
      ],
      "default": "trialing",
      "description": "Stripe subscription status"
    },
    "trial_ends_at": {
      "type": "string",
      "description": "ISO date when trial expires"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "max_employees": {
      "type": "number",
      "default": 3,
      "description": "Max employee seats"
    },
    "max_clients": {
      "type": "number",
      "default": 25,
      "description": "Max client records"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}