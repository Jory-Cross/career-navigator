{
  "name": "PendingRoleAssignment",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the invited user"
    },
    "role": {
      "type": "string",
      "enum": [
        "employee",
        "management",
        "admin",
        "client",
        "pre_ets",
        "dspd",
        "pre_ets_employer",
        "ce_instructor",
        "ce_student"
      ],
      "description": "Role to assign when they register"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "client_portal",
        "staff",
        "admin",
        "pre_ets_employer_portal",
        "ce_training_portal"
      ],
      "description": "Portal access level to assign"
    },
    "org_id": {
      "type": "string",
      "description": "Org ID to stamp on the user when they register"
    },
    "invited_by_id": {
      "type": "string",
      "description": "User ID of the person who sent the invite"
    },
    "invited_by_name": {
      "type": "string",
      "description": "Display name of inviter for UI"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation was created"
    },
    "client_id": {
      "type": "string",
      "description": "Client record ID this portal invite is linked to (for client/pre_ets/dspd/pre_ets_employer roles)"
    },
    "cohort_id": {
      "type": "string",
      "description": "Optional intended CE Training cohort ID for a CE student invite. This may remain blank until an instructor creates or selects the cohort."
    },
    "cohort_role": {
      "type": "string",
      "enum": [
        "manager",
        "member",
        "student"
      ],
      "description": "Cohort-local role for CE training users (student for ce_student role)"
    },
    "payment_responsibility": {
      "type": "string",
      "enum": [
        "student_paid",
        "instructor_paid"
      ],
      "description": "For CE student invites only: whether the student pays the registration fee or the instructor/business pays it."
    },
    "instructor_payment_mode": {
      "type": "string",
      "enum": [
        "pay_now",
        "invoice_with_cohort"
      ],
      "description": "For instructor_paid CE student invites only: whether the registration fee is paid immediately or included on a later cohort invoice."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "invite_email_sent",
        "pending_email_failed",
        "accepted",
        "expired",
        "revoked"
      ],
      "default": "pending",
      "description": "Current invitation status. Payment settlement remains authoritative in OrganizationBillingEvent."
    }
  },
  "required": [
    "email",
    "role"
  ]
}
