{
  "name": "PendingRoleAssignment",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the invited user"
    },
    "role": {
      "type": "string",
      "enum": [
        "employee",
        "management",
        "admin",
        "client",
        "pre_ets",
        "dspd"
      ],
      "description": "Role to assign when they register"
    },
    "org_id": {
      "type": "string",
      "description": "Org ID to stamp on the user when they register"
    },
    "invited_by_id": {
      "type": "string",
      "description": "User ID of the person who sent the invite \u2014 becomes the new user's manager_id"
    },
    "client_id": {
      "type": "string",
      "description": "Client record ID this portal invite is linked to (for client/pre_ets/dspd roles)"
    }
  },
  "required": [
    "email",
    "role"
  ]
}