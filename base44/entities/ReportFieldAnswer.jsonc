{
  "name": "ReportFieldAnswer",
  "type": "object",
  "description": "Snapshot of all dynamic answers for a single TimeEntry.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "time_entry_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "field_schema_version": {
      "type": "number",
      "default": 1
    },
    "field_schema_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "answers": {
      "type": "object",
      "additionalProperties": true
    },
    "required_fields_complete": {
      "type": "boolean",
      "default": false
    },
    "report_ready": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string"
    }
  },
  "required": [
    "time_entry_id",
    "entry_type_id",
    "entry_type_code",
    "answers"
  ]
}