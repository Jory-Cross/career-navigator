{
  "name": "ReportFieldAnswer",
  "type": "object",
  "description": "Schema-versioned snapshot of all dynamic field answers for a single TimeEntry. One record per TimeEntry. Immutable after report generation.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "time_entry_id": {
      "type": "string",
      "description": "FK to TimeEntry (1:1)"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "field_schema_version": {
      "type": "number",
      "default": 1,
      "description": "Version of the ReportFieldTemplate schema at time of submission"
    },
    "field_schema_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "description": "Point-in-time copy of field definitions used. Preserves meaning even if templates change."
    },
    "answers": {
      "type": "object",
      "additionalProperties": true,
      "description": "Map of field_key \u2192 answer value. These values populate PDF row fields."
    },
    "required_fields_complete": {
      "type": "boolean",
      "default": false
    },
    "report_ready": {
      "type": "boolean",
      "default": false,
      "description": "True when all required fields are complete and entry is approved"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO datetime of last answer submission"
    },
    "locked_in_report_id": {
      "type": "string",
      "description": "ID of GeneratedReport that locked these answers. Null if not yet included in a report."
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of field_keys that failed validation on last submit attempt"
    },
    "completion_percent": {
      "type": "number",
      "default": 0,
      "description": "0-100 percent of required fields completed. Useful for UI progress indicators."
    }
  },
  "required": [
    "time_entry_id",
    "entry_type_id",
    "entry_type_code",
    "answers"
  ]
}