{
  "name": "Document",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "resume",
        "cover_letter",
        "contract",
        "notes",
        "reference",
        "certification",
        "portfolio",
        "other"
      ],
      "default": "other"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "parent_document_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "title",
    "file_url"
  ]
}