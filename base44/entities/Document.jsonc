{
  "name": "Document",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "resume",
        "cover_letter",
        "contract",
        "notes",
        "reference",
        "certification",
        "portfolio",
        "vr_report",
        "other"
      ],
      "default": "other",
      "description": "Broad category. Use 'vr_report' for all generated VR PDFs."
    },
    "document_subtype": {
      "type": "string",
      "enum": [
        "job_development_report",
        "job_coaching_report",
        "life_skills_report",
        "cbh_report",
        "pre_ets_report",
        "training_progress_report",
        "wble_form",
        "wsa_form",
        "assessment_pdf",
        "uploaded_resume",
        "uploaded_assessment",
        "uploaded_other"
      ],
      "description": "Specific document subtype for filtering and display. Distinguishes generated reports from uploaded files."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "generated",
        "uploaded",
        "imported"
      ],
      "default": "uploaded",
      "description": "How this document was created. 'generated' = system-produced PDF, 'uploaded' = user-uploaded file."
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source record that triggered generation (e.g. ReportBatch.id, ReportVersion.id)"
    },
    "is_generated": {
      "type": "boolean",
      "default": false,
      "description": "True if this document was auto-generated by the system (not uploaded by a user)"
    },
    "generated_from_template_id": {
      "type": "string",
      "description": "Reference to PDFTemplate used to generate this document"
    },
    "report_batch_id": {
      "type": "string",
      "description": "Reference to ReportBatch if generated as part of a batch"
    },
    "report_version": {
      "type": "number",
      "description": "Version number of this generated report (1, 2, 3...). Used with ReportVersion entity."
    },
    "reporting_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the reporting period covered by this document (for VR reports)"
    },
    "reporting_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the reporting period covered by this document (for VR reports)"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Document version (legacy file versioning)"
    },
    "parent_document_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "title",
    "file_url"
  ]
}