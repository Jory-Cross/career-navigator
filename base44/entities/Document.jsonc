{
  "name": "Document",
  "type": "object",
  "description": "Stored file attached to a client, including uploaded docs and generated reports.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "resume",
        "cover_letter",
        "assessment",
        "generated_report",
        "authorization",
        "notes",
        "reference",
        "certification",
        "portfolio",
        "other"
      ],
      "default": "other"
    },
    "document_subtype": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "generated_from_template_id": {
      "type": "string"
    },
    "report_batch_id": {
      "type": "string"
    },
    "report_version": {
      "type": "number"
    },
    "reporting_period_start": {
      "type": "string",
      "format": "date"
    },
    "reporting_period_end": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "parent_document_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "is_generated": {
      "type": "boolean",
      "default": false
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "title",
    "file_url"
  ]
}