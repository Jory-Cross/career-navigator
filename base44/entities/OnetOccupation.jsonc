{
  "name": "OnetOccupation",
  "type": "object",
  "description": "Master cached O*NET occupation catalog used to store occupation metadata such as Job Zone so the app does not repeatedly call O*NET for the same occupation.",
  "properties": {
    "onet_code": {
      "type": "string",
      "description": "O*NET occupation code, such as 43-1011.00"
    },
    "title": {
      "type": "string",
      "description": "O*NET occupation title"
    },
    "description": {
      "type": "string",
      "description": "O*NET occupation description"
    },
    "job_zone": {
      "type": "number",
      "description": "Verified O*NET Job Zone number, 1 through 5"
    },
    "job_zone_title": {
      "type": "string",
      "description": "Verified O*NET Job Zone title"
    },
    "bright_outlook": {
      "type": "boolean",
      "default": false,
      "description": "Whether this occupation has a Bright Outlook tag from O*NET"
    },
    "green": {
      "type": "boolean",
      "default": false,
      "description": "Whether this occupation has a Green tag from O*NET"
    },
    "source": {
      "type": "string",
      "default": "onet",
      "description": "Source of the occupation metadata"
    },
    "last_verified_at": {
      "type": "string",
      "description": "Date/time this occupation metadata was last verified from O*NET"
    }
  },
  "required": [
    "onet_code",
    "title"
  ]
}