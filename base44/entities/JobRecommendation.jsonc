{
  "name": "JobRecommendation",
  "type": "object",
  "description": "AI-generated recommendation with staff review workflow.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "pay": {
      "type": "string"
    },
    "schedule": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "fit_reason": {
      "type": "string"
    },
    "concerns": {
      "type": "string"
    },
    "support_strategy": {
      "type": "string"
    },
    "fit_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "staff_reviewed",
        "shared_with_client",
        "applied",
        "interview",
        "closed_not_fit",
        "closed_declined",
        "hired"
      ],
      "default": "suggested"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_by_ai": {
      "type": "boolean",
      "default": true
    },
    "reviewed_by_staff": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "assessments_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_fields_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_terms_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "client_id",
    "job_title",
    "employer"
  ]
}