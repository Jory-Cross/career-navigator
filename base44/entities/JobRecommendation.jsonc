{
  "name": "JobRecommendation",
  "type": "object",
  "description": "Job recommendation for a client. AI-generated recommendations start as 'suggested' and require staff review before being shared with the client.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to the Client"
    },
    "batch_id": {
      "type": "string",
      "description": "Groups all recommendations from one generation run (legacy)"
    },
    "source_search_batch_id": {
      "type": "string",
      "description": "ID of the job search batch that produced this recommendation"
    },
    "job_title": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "pay": {
      "type": "string"
    },
    "schedule": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "description": "Direct application / job posting link"
    },
    "fit_reason": {
      "type": "string",
      "description": "Why this job matches the client"
    },
    "concerns": {
      "type": "string",
      "description": "Potential barriers or concerns"
    },
    "support_strategy": {
      "type": "string",
      "description": "Recommended accommodations / support"
    },
    "fit_score": {
      "type": "number",
      "description": "0-100 confidence/fit score"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "staff_reviewed",
        "shared_with_client",
        "applied",
        "interview",
        "closed_not_fit",
        "closed_declined",
        "hired"
      ],
      "default": "suggested",
      "description": "Workflow state. AI-generated recommendations start at 'suggested' \u2014 staff must review before progressing."
    },
    "generated_by_ai": {
      "type": "boolean",
      "default": false,
      "description": "True if this recommendation was produced by AI rather than manually entered by staff"
    },
    "generated_by": {
      "type": "string",
      "description": "Email of user (or system) who generated this recommendation"
    },
    "reviewed_by_staff": {
      "type": "boolean",
      "default": false,
      "description": "Whether a staff member has reviewed and approved this recommendation"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of staff member who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when staff review was completed"
    },
    "review_notes": {
      "type": "string",
      "description": "Staff notes from review (e.g. concerns, edits made, rationale for sharing)"
    },
    "assessments_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of assessments used to generate this recommendation"
    },
    "client_fields_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of client fields that informed this recommendation"
    },
    "search_terms_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "client_id",
    "job_title",
    "employer"
  ]
}