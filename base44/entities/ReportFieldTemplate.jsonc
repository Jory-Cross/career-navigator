{
  "name": "ReportFieldTemplate",
  "type": "object",
  "description": "Defines a dynamic form field/question for a specific entry type.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "field_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "textarea",
        "number",
        "date",
        "time",
        "select",
        "multiselect",
        "checkbox",
        "boolean"
      ],
      "default": "text"
    },
    "field_group": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placeholder": {
      "type": "string"
    },
    "help_text": {
      "type": "string"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "is_reportable": {
      "type": "boolean",
      "default": true
    },
    "is_internal_only": {
      "type": "boolean",
      "default": false
    },
    "pdf_context": {
      "type": "string",
      "enum": [
        "header",
        "row",
        "summary",
        "none"
      ],
      "default": "row"
    },
    "maps_to_form_code": {
      "type": "string"
    },
    "validation_rule": {
      "type": "string"
    },
    "conditional_logic": {
      "type": "object",
      "additionalProperties": true
    },
    "schema_version": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "entry_type_id",
    "entry_type_code",
    "field_key",
    "label"
  ]
}