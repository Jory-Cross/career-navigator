{
  "name": "PlatformPricingSchedulePlanFeature",
  "type": "object",
  "description": "Locked pricing-schedule plan-feature definition. Access is server-authorized and governed by the pricing lifecycle.",
  "properties": {
    "pricing_schedule_id": { "type": "string" },
    "platform_plan_id": { "type": "string" },
    "platform_feature_id": { "type": "string" },
    "platform_plan_feature_id": { "type": "string" },
    "pricing_schedule_plan_feature_key": { "type": "string" },
    "plan_key_snapshot": { "type": "string" },
    "feature_key": { "type": "string" },
    "feature_name_snapshot": { "type": "string" },
    "is_included": { "type": "boolean", "default": false },
    "is_add_on_available": { "type": "boolean", "default": false },
    "default_limit_value": { "type": "number" },
    "is_active": { "type": "boolean", "default": true },
    "effective_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "required": [
    "pricing_schedule_id",
    "platform_plan_id",
    "platform_feature_id",
    "pricing_schedule_plan_feature_key",
    "plan_key_snapshot",
    "feature_key",
    "is_included",
    "is_add_on_available",
    "is_active",
    "effective_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}