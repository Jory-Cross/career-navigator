{
  "name": "GeneratedReport",
  "type": "object",
  "description": "Immutable record of one generated client report version.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "report_batch_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "pdf_template_id": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "report_start_date": {
      "type": "string",
      "format": "date"
    },
    "report_end_date": {
      "type": "string",
      "format": "date"
    },
    "included_time_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "included_answer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assembled_report_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "generated_document_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "supersedes_report_id": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "entry_type_code",
    "pdf_template_id",
    "template_version",
    "generated_document_id"
  ]
}