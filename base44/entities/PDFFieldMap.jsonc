{
  "name": "PDFFieldMap",
  "type": "object",
  "description": "Maps assembled report data into PDF fields, including repeating rows.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "pdf_template_id": {
      "type": "string"
    },
    "pdf_field_name": {
      "type": "string"
    },
    "mapping_scope": {
      "type": "string",
      "enum": [
        "header",
        "row",
        "summary",
        "static"
      ],
      "default": "header"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "time_entry",
        "report_answer",
        "client",
        "employee",
        "authorization",
        "assembled_report",
        "static"
      ]
    },
    "source_field": {
      "type": "string"
    },
    "row_group": {
      "type": "string"
    },
    "row_field_key": {
      "type": "string"
    },
    "row_sort_order": {
      "type": "number"
    },
    "aggregation_mode": {
      "type": "string",
      "enum": [
        "first",
        "last",
        "sum",
        "count",
        "concat",
        "custom",
        "none"
      ],
      "default": "none"
    },
    "transform": {
      "type": "string",
      "enum": [
        "none",
        "date_format",
        "time_format",
        "hours_from_minutes",
        "uppercase",
        "full_name"
      ],
      "default": "none"
    },
    "transform_options": {
      "type": "object",
      "additionalProperties": true
    },
    "default_value": {
      "type": "string"
    },
    "static_value": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    }
  },
  "required": [
    "pdf_template_id",
    "pdf_field_name",
    "mapping_scope"
  ]
}