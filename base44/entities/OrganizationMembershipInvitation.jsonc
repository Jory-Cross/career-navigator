{
  "name": "OrganizationMembershipInvitation",
  "type": "object",
  "description": "Organization membership invitation. Invitation creation, role assignment, acceptance, and revocation are server-authorized and auditable.",
  "properties": {
    "organization_id": { "type": "string", "description": "Organization tenant inviting this person." },
    "email": { "type": "string", "description": "Email address receiving the organization invitation." },
    "email_normalized": { "type": "string", "description": "Lowercase, trimmed copy of the invited email." },
    "target_user_id": { "type": "string", "description": "Registered User ID once invitation is matched." },
    "organization_role_ids": { "type": "array", "items": { "type": "string" }, "default": [], "description": "OrganizationRole IDs assigned only through authorized acceptance." },
    "invitation_context": { "type": "string", "enum": ["organization_membership", "ce_training_enrollment", "ce_practitioner_onboarding", "migration"], "default": "organization_membership" },
    "invitation_status": { "type": "string", "enum": ["draft", "pending", "invite_email_sent", "pending_email_failed", "accepted", "expired", "revoked"], "default": "pending" },
    "invited_by_user_id": { "type": "string" },
    "invited_by_membership_id": { "type": "string" },
    "invited_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "accepted_at": { "type": "string", "format": "date-time" },
    "accepted_membership_id": { "type": "string" },
    "message": { "type": "string" },
    "source": { "type": "string", "enum": ["organization_admin", "platform_admin", "self_service", "migration"], "default": "organization_admin" }
  },
  "required": [
    "organization_id",
    "email",
    "email_normalized",
    "organization_role_ids",
    "invitation_context",
    "invitation_status",
    "invited_at",
    "expires_at",
    "source"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}