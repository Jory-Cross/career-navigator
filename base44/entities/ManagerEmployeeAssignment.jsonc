{
  "name": "ManagerEmployeeAssignment",
  "type": "object",
  "description": "Organization-scoped delegated visibility assignment from a manager to an employee. This record is the canonical source for manager access to direct-report staff and their assigned clients.",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Canonical Organization.id scope. Required for every manager-to-employee assignment."
    },
    "manager_user_id": {
      "type": "string",
      "description": "Canonical User.id of the active manager or administrator receiving delegated visibility."
    },
    "employee_user_id": {
      "type": "string",
      "description": "Canonical User.id of the employee whose assigned-client and staff visibility is delegated."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Only active, non-archived assignments grant delegated manager visibility."
    }
  },
  "required": [
    "org_id",
    "manager_user_id",
    "employee_user_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}