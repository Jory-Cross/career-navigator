{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "management",
        "employee",
        "client",
        "pre_ets",
        "dspd"
      ],
      "default": "employee"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "client_portal",
        "staff",
        "admin"
      ],
      "description": "Portal access level granted via invitation"
    },
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the manager/admin who invited this user"
    },
    "linked_client_id": {
      "type": "string",
      "description": "Client record ID linked to this user (for client portal users)"
    },
    "phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    }
  }
}