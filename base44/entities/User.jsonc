{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "management",
        "employee",
        "client",
        "pre_ets",
        "dspd",
        "pre_ets_employer"
      ],
      "default": "employee",
      "description": "User's role. 'user' is the platform default before onUserRegistered upgrades it."
    },
    "access_level": {
      "type": "string",
      "enum": [
        "client_portal",
        "staff",
        "admin",
        "pre_ets_employer_portal"
      ],
      "description": "Access level granted via invitation. Blank = denied everywhere."
    },
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the manager/admin who invited this user"
    },
    "linked_client_id": {
      "type": "string",
      "description": "Client record ID linked to this user (for client portal users)"
    },
    "phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    }
  },
  "required": []
}