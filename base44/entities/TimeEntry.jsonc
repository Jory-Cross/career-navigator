{
  "name": "TimeEntry",
  "type": "object",
  "description": "Source service record. One row per staff time entry. The authoritative data source for all VR reporting.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "service_authorization_id": {
      "type": "string",
      "description": "FK to ServiceAuthorization"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "reporting_period_key": {
      "type": "string",
      "description": "YYYY-MM for monthly reports, or YYYY-QN for service-period reports"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Internal staff note only \u2014 not used for PDF reporting"
    },
    "is_billable": {
      "type": "boolean",
      "default": false
    },
    "is_payroll_eligible": {
      "type": "boolean",
      "default": true
    },
    "is_reportable": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "locked",
        "void"
      ],
      "default": "submitted"
    },
    "legacy_category": {
      "type": "string",
      "description": "Backward-compat field for pre-EntryType category enum. Do not use for new entries."
    },
    "employer_name": {
      "type": "string",
      "description": "Denormalized employer for entries where employer may differ per visit"
    },
    "report_ready": {
      "type": "boolean",
      "default": false,
      "description": "True when field answers are complete and entry is approved for reporting"
    },
    "locked_in_report_id": {
      "type": "string",
      "description": "ID of GeneratedReport that locked this entry. Null if not yet in a final report."
    }
  },
  "required": [
    "employee_id",
    "date",
    "duration_minutes"
  ]
}