{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "client_id": {
      "type": "string"
    },
    "service_authorization_id": {
      "type": "string",
      "description": "Reference to ServiceAuthorization this time entry applies to"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string",
      "description": "Reference to EntryType.id (true source of truth for VR reporting)"
    },
    "entry_type_code": {
      "type": "string",
      "description": "Denormalized EntryType.code for fast lookups (e.g. job_coaching, cbh)"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "consultation",
        "resume_work",
        "job_search",
        "interview_prep",
        "follow_up",
        "job_coaching",
        "life_skills",
        "cbh",
        "admin",
        "other"
      ],
      "description": "Legacy field for backward compatibility only. Do not use for VR reporting."
    },
    "general_notes": {
      "type": "string",
      "description": "Internal notes not included in VR reports"
    }
  },
  "required": [
    "duration_minutes",
    "entry_type_id",
    "entry_type_code"
  ]
}