{
  "name": "TimeEntry",
  "type": "object",
  "description": "Source service record. One row per staff time entry.",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "service_authorization_id": {
      "type": "string"
    },
    "entry_type_id": {
      "type": "string"
    },
    "entry_type_code": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "reporting_period_key": {
      "type": "string",
      "description": "Example: 2026-04"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Internal summary only, not source of truth for reporting"
    },
    "is_billable": {
      "type": "boolean",
      "default": false
    },
    "is_payroll_eligible": {
      "type": "boolean",
      "default": true
    },
    "is_reportable": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "locked",
        "void"
      ],
      "default": "submitted"
    },
    "legacy_category": {
      "type": "string",
      "description": "Optional backward-compat field for old category enum"
    }
  },
  "required": [
    "employee_id",
    "entry_type_id",
    "entry_type_code",
    "date",
    "duration_minutes"
  ]
}