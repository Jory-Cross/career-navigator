{
  "name": "OrganizationMembership",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization tenant the person belongs to."
    },
    "user_id": {
      "type": "string",
      "description": "Registered platform user ID for this membership."
    },
    "membership_status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "suspended",
        "ended"
      ],
      "default": "invited",
      "description": "Lifecycle status for this person's membership in the organization."
    },
    "is_organization_owner": {
      "type": "boolean",
      "default": false,
      "description": "Marks the person as an owner of this organization tenant. This does not itself grant app permissions."
    },
    "joined_at": {
      "type": "string",
      "description": "ISO timestamp when the membership became active."
    },
    "ended_at": {
      "type": "string",
      "description": "ISO timestamp when this membership ended, if applicable."
    }
  },
  "required": [
    "organization_id",
    "user_id",
    "membership_status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}