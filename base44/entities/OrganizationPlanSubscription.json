{
  "name": "OrganizationPlanSubscription",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string", "description": "Paying organization tenant subscribed to this platform plan." },
    "platform_plan_id": { "type": "string", "description": "PlatformPlan record currently purchased or previously purchased by this organization." },
    "pricing_schedule_id": { "type": "string", "description": "PlatformPricingSchedule assigned to this subscription." },
    "pricing_schedule_key_snapshot": { "type": "string", "description": "Copied pricing schedule key retained for history." },
    "subscription_key": { "type": "string", "description": "Stable unique subscription identifier." },
    "subscription_status": { "type": "string", "enum": ["trialing", "active", "past_due", "cancelled", "incomplete", "suspended", "expired"], "description": "Current lifecycle and billing status." },
    "billing_interval": { "type": "string", "enum": ["monthly", "annual"], "description": "Billing frequency." },
    "stripe_customer_id": { "type": "string" },
    "stripe_subscription_id": { "type": "string" },
    "starts_at": { "type": "string" },
    "trial_ends_at": { "type": "string" },
    "current_period_starts_at": { "type": "string" },
    "current_period_ends_at": { "type": "string" },
    "cancelled_at": { "type": "string" },
    "ends_at": { "type": "string" },
    "is_current": { "type": "boolean", "default": true },
    "subscription_source": { "type": "string", "enum": ["self_service", "platform_admin", "migration", "manual_invoice"], "default": "self_service" },
    "notes": { "type": "string" }
  },
  "required": ["organization_id", "platform_plan_id", "subscription_key", "subscription_status", "billing_interval", "starts_at", "is_current", "subscription_source"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}