{
  "name": "Client",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Tenant organization ID"
    },
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "email": {
      "type": "string",
      "description": "Client's email address"
    },
    "phone": {
      "type": "string",
      "description": "Client's phone number"
    },
    "address": {
      "type": "string",
      "description": "Client's home address"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "job_seeker",
        "pre_ets",
        "dspd",
        "employed"
      ],
      "default": "job_seeker",
      "description": "Type of client program"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "completed"
      ],
      "default": "active",
      "description": "Client engagement status"
    },
    "industry": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "resume_file_url": {
      "type": "string"
    },
    "resume_file_name": {
      "type": "string"
    },
    "cover_letter_file_url": {
      "type": "string"
    },
    "cover_letter_file_name": {
      "type": "string"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "onboarding_started_date": {
      "type": "string",
      "format": "date"
    },
    "onboarding_completed_date": {
      "type": "string",
      "format": "date"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "assigned_employee_id": {
      "type": "string"
    },
    "assigned_employer_id": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_phone": {
      "type": "string"
    },
    "guardian_email": {
      "type": "string"
    },
    "support_staff_name": {
      "type": "string"
    },
    "support_staff_phone": {
      "type": "string"
    },
    "support_staff_email": {
      "type": "string"
    },
    "workplace_name": {
      "type": "string"
    },
    "workplace_address": {
      "type": "string"
    },
    "supervisor_name": {
      "type": "string"
    },
    "supervisor_phone": {
      "type": "string"
    },
    "supervisor_email": {
      "type": "string"
    },
    "employment_start_date": {
      "type": "string",
      "format": "date"
    },
    "vocational_facts_profile": {
      "type": "object",
      "description": "Structured employment facts extracted from assessments and documents by AI preprocessing",
      "additionalProperties": true
    },
    "vocational_facts_extracted_at": {
      "type": "string",
      "description": "ISO datetime when vocational facts were last extracted"
    },
    "vocational_facts_extracted_by": {
      "type": "string",
      "description": "Email of user who ran the extraction"
    },
    "vocational_facts_document_count": {
      "type": "number",
      "description": "Number of documents analyzed in last extraction"
    },
    "vocational_facts_assessment_count": {
      "type": "number",
      "description": "Number of assessments analyzed in last extraction"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}