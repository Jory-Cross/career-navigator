{
  "name": "OrganizationPricingScheduleAssignment",
  "type": "object",
  "description": "Versioned pricing-schedule assignment for an organization. Access is server-authorized and governed by the billing lifecycle.",
  "properties": {
    "organization_id": { "type": "string" },
    "pricing_schedule_id": { "type": "string" },
    "pricing_schedule_key_snapshot": { "type": "string" },
    "assignment_status": { "type": "string", "enum": ["scheduled", "active", "ended", "cancelled"], "default": "scheduled" },
    "effective_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "organization_plan_subscription_id": { "type": "string" },
    "assignment_source": { "type": "string", "enum": ["new_account", "platform_admin", "migration", "plan_change", "contract_renewal"] },
    "assigned_by_user_id": { "type": "string" },
    "change_reason": { "type": "string" },
    "notes": { "type": "string" }
  },
  "required": [
    "organization_id",
    "pricing_schedule_id",
    "assignment_status",
    "effective_at",
    "assignment_source"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}